      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{4f06ee8b-020e-4b32-8099-74d1dea550be}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Registrar Ejecucion"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"INSERT INTO tb_ejecuciones_etl (fecha_inicio, fecha_fin, registros_leidos, registros_insertados, registros_error) VALUES ('" + (DT_WSTR,4)DATEPART("yyyy",@[System::StartTime]) + "-" + RIGHT("0" + (DT_WSTR,2)DATEPART("mm",@[System::StartTime]),2) + "-" + RIGHT("0" + (DT_WSTR,2)DATEPART("dd",@[System::StartTime]),2) + " " + RIGHT("0" + (DT_WSTR,2)DATEPART("hh",@[System::StartTime]),2) + ":" + RIGHT("0" + (DT_WSTR,2)DATEPART("mi",@[System::StartTime]),2) + ":" + RIGHT("0" + (DT_WSTR,2)DATEPART("ss",@[System::StartTime]),2) + "','" + (DT_WSTR,4)DATEPART("yyyy",@[User::FechaFin]) + "-" + RIGHT("0" + (DT_WSTR,2)DATEPART("mm",@[User::FechaFin]),2) + "-" + RIGHT("0" + (DT_WSTR,2)DATEPART("dd",@[User::FechaFin]),2) + " " + RIGHT("0" + (DT_WSTR,2)DATEPART("hh",@[User::FechaFin]),2) + ":" + RIGHT("0" + (DT_WSTR,2)DATEPART("mi",@[User::FechaFin]),2) + ":" + RIGHT("0" + (DT_WSTR,2)DATEPART("ss",@[User::FechaFin]),2) + "'," + (DT_WSTR,10)@[User::RegistrosLeidos] + "," + (DT_WSTR,10)@[User::RegistrosValidos] + "," + (DT_WSTR,10)@[User::RegistrosError] + ");"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D7E78E45-0DD6-415C-8983-6B3E760BBC67}"
          SQLTask:SqlStatementSource="INSERT INTO tb_ejecuciones_etl (fecha_inicio, fecha_fin, registros_leidos, registros_insertados, registros_error) VALUES ('2026-08-24 08:06:29','2026-08-24 11:00:52',0,0,0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Upsert Dim Jugadores"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{10bfb321-f1bb-439d-9872-27b03bf9a9f3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Upsert Dim Jugadores"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D7E78E45-0DD6-415C-8983-6B3E760BBC67}"
          SQLTask:SqlStatementSource="INSERT INTO dim_jugadores (nombre_jugador, pais)&#xA;SELECT DISTINCT nombre_jugador, pais FROM stg_estadisticas&#xA;ON CONFLICT (nombre_jugador, pais) DO NOTHING;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Upsert Dim Partidos"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{50d2563b-2aec-4ac9-a84b-21bcbb999392}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Upsert Dim Partidos"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D7E78E45-0DD6-415C-8983-6B3E760BBC67}"
          SQLTask:SqlStatementSource="INSERT INTO dim_partidos (equipo_local, equipo_visitante, fecha_partido)&#xA;SELECT DISTINCT equipo_local, equipo_visitante, fecha_partido FROM stg_estadisticas&#xA;ON CONFLICT (equipo_local, equipo_visitante, fecha_partido) DO NOTHING;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Upsert Fact Estadisticas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{7fd47e30-5241-40e6-8c7a-78408fb8035a}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Upsert Fact Estadisticas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D7E78E45-0DD6-415C-8983-6B3E760BBC67}"
          SQLTask:SqlStatementSource="INSERT INTO fact_estadisticas (jugador_id, partido_id, goles, asistencias)&#xA;SELECT j.jugador_id, p.partido_id, MAX(s.goles) AS goles, MAX(s.asistencias) AS asistencias&#xA;FROM stg_estadisticas s&#xA;JOIN dim_jugadores j ON j.nombre_jugador = s.nombre_jugador AND j.pais = s.pais&#xA;JOIN dim_partidos p ON p.equipo_local = s.equipo_local&#xA;                    AND p.equipo_visitante = s.equipo_visitante&#xA;                    AND p.fecha_partido = s.fecha_partido&#xA;GROUP BY j.jugador_id, p.partido_id&#xA;ON CONFLICT (jugador_id, partido_id) DO UPDATE&#xA;SET goles = EXCLUDED.goles, asistencias = EXCLUDED.asistencias;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Vaciar Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{95394B4E-59E3-40B8-B5A2-CFD9E85FC397}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Vaciar Staging"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D7E78E45-0DD6-415C-8983-6B3E760BBC67}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE stg_estadisticas;&#xA;TRUNCATE TABLE stg_errores;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
